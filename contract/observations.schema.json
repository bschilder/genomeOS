{
  "checks": [
    {
      "options": {
        "check_name": "ac_le_an",
        "error": "ac must not exceed an"
      }
    },
    {
      "options": {
        "check_name": "date_lower_le_upper",
        "error": "date_lower must not exceed date_upper"
      }
    }
  ],
  "coerce": true,
  "columns": {
    "ac": {
      "dtype": "int64",
      "greater_than_or_equal_to": 0
    },
    "an": {
      "dtype": "int64",
      "greater_than": 0
    },
    "assay": {
      "dtype": "string[pyarrow]",
      "str_length": {
        "exact_value": null,
        "max_value": null,
        "min_value": 1
      }
    },
    "cohort_id": {
      "dtype": "string[pyarrow]",
      "str_length": {
        "exact_value": null,
        "max_value": null,
        "min_value": 1
      }
    },
    "date_lower": {
      "dtype": "int64",
      "greater_than_or_equal_to": 0
    },
    "date_upper": {
      "dtype": "int64",
      "greater_than_or_equal_to": 0
    },
    "disease_ascertainment_excluded": {
      "dtype": "boolean"
    },
    "ingest_version": {
      "dtype": "string[pyarrow]",
      "str_length": {
        "exact_value": null,
        "max_value": null,
        "min_value": 1
      }
    },
    "lat": {
      "dtype": "float64",
      "in_range": {
        "include_max": true,
        "include_min": true,
        "max_value": 90.0,
        "min_value": -90.0
      }
    },
    "lon": {
      "dtype": "float64",
      "in_range": {
        "include_max": true,
        "include_min": true,
        "max_value": 180.0,
        "min_value": -180.0
      }
    },
    "population_id": {
      "dtype": "string[pyarrow]"
    },
    "radius_km": {
      "dtype": "float64",
      "greater_than": 0.0
    },
    "rsid": {
      "dtype": "string[pyarrow]",
      "nullable": true
    },
    "sampling_design": {
      "dtype": "string[pyarrow]",
      "isin": [
        "population_random",
        "healthy_reference",
        "clinical_case",
        "clinical_control",
        "newborn_screening",
        "carrier_screening",
        "convenience"
      ]
    },
    "source": {
      "dtype": "string[pyarrow]",
      "str_length": {
        "exact_value": null,
        "max_value": null,
        "min_value": 1
      }
    },
    "variant_id": {
      "dtype": "string[pyarrow]",
      "str_matches": "^(?:chr(?:[1-9]|1[0-9]|2[0-2]|X|Y|M)-\\d+-[ACGT]+-[ACGT]+|phenotype:[a-z0-9][a-z0-9-]*|(?:hla|kir|mic|cyt):[a-z0-9][a-z0-9._-]*)$"
    }
  },
  "drop_invalid_rows": false,
  "name": "observations",
  "schema_type": "dataframe",
  "strict": true
}
