<div class="scroll-progress" aria-hidden="true"><span></span></div>

<script>
  const reducedMotion = window.matchMedia('(prefers-reduced-motion: reduce)');

  if (!reducedMotion.matches) {
    document.documentElement.classList.add('motion-ready');

    const revealed = document.querySelectorAll<HTMLElement>('[data-reveal]');
    const observer = new IntersectionObserver(
      (entries) => {
        for (const entry of entries) {
          if (!entry.isIntersecting) continue;
          entry.target.classList.add('is-visible');
          observer.unobserve(entry.target);
        }
      },
      { rootMargin: '0px 0px -9% 0px', threshold: 0.08 },
    );
    revealed.forEach((element) => observer.observe(element));

    const hero = document.querySelector<HTMLElement>('.hero');
    const heroImage = document.querySelector<HTMLElement>('.hero__image');
    const progress = document.querySelector<HTMLElement>('.scroll-progress');
    let frame = 0;

    const renderScroll = () => {
      frame = 0;
      const pageRange =
        document.documentElement.scrollHeight - window.innerHeight;
      const pageProgress = pageRange > 0 ? window.scrollY / pageRange : 0;
      progress?.style.setProperty(
        '--scroll-progress',
        String(Math.min(1, Math.max(0, pageProgress))),
      );

      if (hero && heroImage) {
        const heroProgress = Math.min(
          1,
          Math.max(0, window.scrollY / hero.offsetHeight),
        );
        heroImage.style.setProperty(
          '--hero-scroll-y',
          `${heroProgress * 30}px`,
        );
        heroImage.style.setProperty(
          '--hero-scale',
          String(1.025 + heroProgress * 0.045),
        );
      }
    };

    const scheduleScroll = () => {
      if (!frame) frame = window.requestAnimationFrame(renderScroll);
    };
    window.addEventListener('scroll', scheduleScroll, { passive: true });
    window.addEventListener('resize', scheduleScroll, { passive: true });
    renderScroll();

    hero?.addEventListener('pointermove', (event) => {
      if (!heroImage || !(event instanceof PointerEvent)) return;
      const bounds = hero.getBoundingClientRect();
      const x = (event.clientX - bounds.left) / bounds.width - 0.5;
      const y = (event.clientY - bounds.top) / bounds.height - 0.5;
      heroImage.style.setProperty('--hero-pointer-x', `${x * -18}px`);
      heroImage.style.setProperty('--hero-pointer-y', `${y * -12}px`);
    });
    hero?.addEventListener('pointerleave', () => {
      heroImage?.style.setProperty('--hero-pointer-x', '0px');
      heroImage?.style.setProperty('--hero-pointer-y', '0px');
    });

    for (const surface of document.querySelectorAll<HTMLElement>(
      '[data-motion-surface]',
    )) {
      surface.addEventListener('pointermove', (event) => {
        if (!(event instanceof PointerEvent)) return;
        const bounds = surface.getBoundingClientRect();
        surface.style.setProperty(
          '--spotlight-x',
          `${event.clientX - bounds.left}px`,
        );
        surface.style.setProperty(
          '--spotlight-y',
          `${event.clientY - bounds.top}px`,
        );
      });
    }
  }
</script>
