---
const states = [
  {
    state: 'Available now',
    className: 'current',
    detail:
      'Versioned population and observation contracts, source adapters, offline inference kernels, and a fixture-backed diagnostic read path.',
  },
  {
    state: 'In active development',
    className: 'active',
    detail:
      'Published-science parity, broader literature evidence, production artifacts, and the interactive product map.',
  },
  {
    state: 'Future exploration',
    className: 'future',
    detail:
      'Conversational evidence access, personal-genome contribution, an ancient-DNA time slider, and the cellular atlas—all gated by evidence and governance.',
  },
];
---

<section class="status-section" aria-labelledby="status-title">
  <div class="section-shell">
    <div class="section-heading section-heading--split">
      <h2 id="status-title">What exists—and what comes later</h2>
      <p>
        Ideas do not become product claims merely because they appear on a
        roadmap.
      </p>
    </div>
    <div class="status-band">
      {
        states.map(({ state, className, detail }) => (
          <article class={`status-band__item status-band__item--${className}`}>
            <h3>{state}</h3>
            <p>{detail}</p>
          </article>
        ))
      }
    </div>
  </div>
</section>
