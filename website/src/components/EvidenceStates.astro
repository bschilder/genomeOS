<section class="evidence-section" aria-labelledby="evidence-title">
  <div class="evidence-grid">
    <div class="evidence-copy">
      <h2 id="evidence-title">
        Measured here.<br />Estimated there.<br />Never confused.
      </h2>
      <p>
        A smooth map can look more certain than the evidence beneath it.
        genomeOS keeps every measurement, model estimate, and unsupported region
        visibly distinct.
      </p>
    </div>
    <div class="evidence-states" aria-label="Three evidence states">
      <article class="evidence-state">
        <div class="evidence-state__mark" aria-hidden="true"></div>
        <h3>Measured</h3>
        <p>A source-anchored observation, including who was sampled and how.</p>
      </article>
      <article class="evidence-state evidence-state--estimated">
        <div class="evidence-state__mark" aria-hidden="true"></div>
        <h3>Estimated</h3>
        <p>
          A model result with uncertainty, versions, and the evidence that
          supports it.
        </p>
      </article>
      <article class="evidence-state evidence-state--unknown">
        <div class="evidence-state__mark" aria-hidden="true"></div>
        <h3>Unknown</h3>
        <p>
          No number when nearby data, denominators, or model support are
          insufficient.
        </p>
      </article>
    </div>
  </div>
</section>
