---
import { sitePath } from '../lib/paths';

const banner = sitePath('/images/genomeos-banner.png');
---

<section class="hero" aria-labelledby="hero-title">
  <div
    class="hero__image"
    role="img"
    aria-label="A glowing view of Earth beside a luminous genomeOS double helix"
    style={`--hero-image: url('${banner}')`}
  >
  </div>
  <div class="hero__content">
    <h1 id="hero-title">Explore genomes across the world.</h1>
    <p class="hero__lede">
      An open atlas of human genetic variation—showing what was measured, what
      can be estimated, and where the honest answer is still “we don't know.”
    </p>
    <div class="hero__actions">
      <a class="button-link" href={sitePath('/working-groups/')}
        >Find your place in the project</a
      >
      <a class="button-link button-link--quiet" href={sitePath('/project/')}
        >Understand the project</a
      >
    </div>
  </div>
</section>
